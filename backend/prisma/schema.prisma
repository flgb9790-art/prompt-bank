generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id               Int           @id @default(autoincrement())
  telegramId       String        @unique
  username         String?
  firstName        String?
  lastName         String?
  saveViewHistory  Boolean       @default(true)
  saveCopyHistory  Boolean       @default(true)
  prompts          Prompt[]
  favorites        Favorite[]
  usages           PromptUsage[]
  views            PromptView[]
  copies           PromptCopy[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

model Category {
  id        Int      @id @default(autoincrement())
  name      String
  slug      String   @unique
  icon      String?
  color     String?
  sortOrder Int      @default(0)
  prompts   Prompt[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Prompt {
  id                  Int                   @id @default(autoincrement())
  userId              Int
  title               String
  content             String
  note                String?
  categoryId          Int
  coverMediaUrl       String?
  coverMediaType      MediaType?
  usageCount          Int                   @default(0)
  telegramPublished   Boolean               @default(false)
  pinterestPublished  Boolean               @default(false)
  user                User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  category            Category              @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  keywords            PromptKeyword[]
  examples            MediaExample[]
  favorites           Favorite[]
  usages              PromptUsage[]
  views               PromptView[]
  copies              PromptCopy[]
  telegramPublications TelegramPublication[]
  pinterestPublications PinterestPublication[]
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  @@index([createdAt(sort: Desc)])
  @@index([categoryId])
}

model TelegramPublication {
  id                Int       @id @default(autoincrement())
  promptId          Int
  status            String
  telegramMessageId String?
  telegramChatId    String?
  error             String?
  postText          String
  mediaType         String?
  prompt            Prompt    @relation(fields: [promptId], references: [id], onDelete: Cascade)
  createdAt         DateTime  @default(now())
  publishedAt       DateTime?
  updatedAt         DateTime  @updatedAt

  @@index([promptId, createdAt(sort: Desc)])
}

model PinterestPublication {
  id               Int       @id @default(autoincrement())
  promptId         Int
  status           String
  pinterestPinId   String?
  pinterestBoardId String?
  publishedUrl     String?
  error            String?
  title            String
  description      String
  destinationLink  String
  mediaType        String?
  mediaUrl         String?
  prompt           Prompt    @relation(fields: [promptId], references: [id], onDelete: Cascade)
  createdAt        DateTime  @default(now())
  publishedAt      DateTime?
  updatedAt        DateTime  @updatedAt

  @@index([promptId, createdAt(sort: Desc)])
}

model PromptView {
  id        Int      @id @default(autoincrement())
  userId    Int
  promptId  Int
  source    String   @default("web")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  prompt    Prompt   @relation(fields: [promptId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([promptId])
  @@index([createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
}

model PromptCopy {
  id        Int      @id @default(autoincrement())
  userId    Int
  promptId  Int
  source    String   @default("web")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  prompt    Prompt   @relation(fields: [promptId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([promptId])
  @@index([createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
}

model PromptUsage {
  id        Int      @id @default(autoincrement())
  userId    Int
  promptId  Int
  count     Int      @default(0)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  prompt    Prompt   @relation(fields: [promptId], references: [id], onDelete: Cascade)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([userId, promptId])
}

model Keyword {
  id      Int            @id @default(autoincrement())
  name    String         @unique
  prompts PromptKeyword[]
}

model PromptKeyword {
  promptId  Int
  keywordId Int
  prompt    Prompt  @relation(fields: [promptId], references: [id], onDelete: Cascade)
  keyword   Keyword @relation(fields: [keywordId], references: [id], onDelete: Cascade)

  @@id([promptId, keywordId])
}

model MediaExample {
  id           Int       @id @default(autoincrement())
  promptId     Int
  url          String
  type         MediaType
  originalName String?
  prompt       Prompt    @relation(fields: [promptId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())
}

model Favorite {
  id        Int      @id @default(autoincrement())
  userId    Int
  promptId  Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  prompt    Prompt   @relation(fields: [promptId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, promptId])
  @@index([userId])
}

enum MediaType {
  image
  video
}
