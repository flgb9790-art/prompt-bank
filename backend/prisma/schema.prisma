generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model IdeaStudioSettings {
  id              String    @id @default("main")
  dailyEnabled    Boolean   @default(false)
  dailyCount      Int       @default(10)
  runAt           String    @default("09:00")
  timeZone        String    @default("Europe/Minsk")
  language        String    @default("en")
  topics          String    @default("Портреты, предметная съёмка, архитектура, мода, природа, сюрреализм")
  useWebSearch    Boolean   @default(true)
  ownerTelegramId String?
  workerToken     String?
  leaseUntil      DateTime?
  updatedAt       DateTime  @updatedAt
}

model IdeaStudioBatch {
  id                String            @id @default(cuid())
  dailyKey          String?           @unique
  creatorTelegramId String
  status            String            @default("queued")
  count             Int
  topics            String
  language          String
  useWebSearch      Boolean
  sourcePrompt      String?           @db.Text
  sources           Json              @default("[]")
  error             String?
  drafts            IdeaStudioDraft[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([createdAt(sort: Desc)])
}

model IdeaStudioDraft {
  id                 String          @id @default(cuid())
  batchId            String
  title              String
  concept            String          @db.Text
  content            String          @db.Text
  imagePrompt        String          @db.Text
  theme              String
  visualStyle        String
  fingerprint        String
  selected           Boolean         @default(false)
  rejected           Boolean         @default(false)
  imageUrl           String?
  imageStatus        String          @default("pending")
  imageError         String?
  imageStale         Boolean         @default(false)
  busyJobId          String?
  publishError       String?
  publishUncertain   Boolean         @default(false)
  promptId           Int?            @unique
  revision           Int             @default(0)
  batch              IdeaStudioBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  prompt             Prompt?         @relation(fields: [promptId], references: [id], onDelete: SetNull)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([batchId, createdAt])
  @@index([fingerprint])
}

model IdeaStudioJob {
  id                String    @id @default(cuid())
  kind              String
  status            String    @default("queued")
  creatorTelegramId String
  payload           Json
  completed         Int       @default(0)
  total             Int       @default(1)
  error             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([status, createdAt])
}

model IdeaStudioUsage {
  id       String @id
  requests Int    @default(0)
}

model PinterestConnection {
  id                    String    @id
  apiBaseUrl            String    @default("https://api.pinterest.com/v5")
  ownerTelegramId       String
  accessTokenEncrypted  String?
  refreshTokenEncrypted String?
  expiresAt             DateTime?
  scope                 String?
  boardId               String?
  boardName             String?
  updatedAt             DateTime  @updatedAt
}

model PinterestOAuthState {
  stateHash       String   @id
  browserHash     String
  ownerTelegramId String
  expiresAt       DateTime
}

model User {
  id               Int           @id @default(autoincrement())
  telegramId       String        @unique
  username         String?
  firstName        String?
  lastName         String?
  saveViewHistory  Boolean       @default(true)
  saveCopyHistory  Boolean       @default(true)
  prompts          Prompt[]
  favorites        Favorite[]
  usages           PromptUsage[]
  views            PromptView[]
  copies           PromptCopy[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

model Category {
  id        Int      @id @default(autoincrement())
  name      String
  slug      String   @unique
  icon      String?
  color     String?
  sortOrder Int      @default(0)
  prompts   Prompt[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Prompt {
  id                  Int                   @id @default(autoincrement())
  userId              Int
  title               String
  content             String
  note                String?
  categoryId          Int
  coverMediaUrl       String?
  coverMediaType      MediaType?
  usageCount          Int                   @default(0)
  telegramPublished   Boolean               @default(false)
  telegramMessageId   String?
  telegramChatId      String?
  telegramPostUrl     String?
  pinterestPublished  Boolean               @default(false)
  telegramPostTemplate String?              @db.Text
  pinterestTitleTemplate String?
  pinterestDescriptionTemplate String?      @db.Text
  user                User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  category            Category              @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  keywords            PromptKeyword[]
  examples            MediaExample[]
  favorites           Favorite[]
  usages              PromptUsage[]
  views               PromptView[]
  copies              PromptCopy[]
  telegramPublications TelegramPublication[]
  pinterestPublications PinterestPublication[]
  studioDraft         IdeaStudioDraft?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  @@index([createdAt(sort: Desc)])
  @@index([categoryId])
}

model TelegramPublication {
  id                Int       @id @default(autoincrement())
  promptId          Int
  status            String
  telegramMessageId String?
  telegramChatId    String?
  error             String?
  postText          String
  mediaType         String?
  prompt            Prompt    @relation(fields: [promptId], references: [id], onDelete: Cascade)
  createdAt         DateTime  @default(now())
  publishedAt       DateTime?
  updatedAt         DateTime  @updatedAt

  @@index([promptId, createdAt(sort: Desc)])
}

model PinterestPublication {
  id               Int       @id @default(autoincrement())
  apiBaseUrl       String    @default("https://api.pinterest.com/v5")
  promptId         Int
  status           String
  pinterestPinId   String?
  pinterestBoardId String?
  publishedUrl     String?
  error            String?
  title            String
  description      String
  destinationLink  String
  mediaType        String?
  mediaUrl         String?
  prompt           Prompt    @relation(fields: [promptId], references: [id], onDelete: Cascade)
  createdAt        DateTime  @default(now())
  publishedAt      DateTime?
  updatedAt        DateTime  @updatedAt

  @@index([promptId, createdAt(sort: Desc)])
}

model PromptView {
  id        Int      @id @default(autoincrement())
  userId    Int
  promptId  Int
  source    String   @default("web")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  prompt    Prompt   @relation(fields: [promptId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([promptId])
  @@index([createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
}

model PromptCopy {
  id        Int      @id @default(autoincrement())
  userId    Int
  promptId  Int
  source    String   @default("web")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  prompt    Prompt   @relation(fields: [promptId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([promptId])
  @@index([createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
}

model PromptUsage {
  id        Int      @id @default(autoincrement())
  userId    Int
  promptId  Int
  count     Int      @default(0)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  prompt    Prompt   @relation(fields: [promptId], references: [id], onDelete: Cascade)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([userId, promptId])
}

model Keyword {
  id      Int            @id @default(autoincrement())
  name    String         @unique
  prompts PromptKeyword[]
}

model PromptKeyword {
  promptId  Int
  keywordId Int
  prompt    Prompt  @relation(fields: [promptId], references: [id], onDelete: Cascade)
  keyword   Keyword @relation(fields: [keywordId], references: [id], onDelete: Cascade)

  @@id([promptId, keywordId])
}

model MediaExample {
  id           Int       @id @default(autoincrement())
  promptId     Int
  url          String
  type         MediaType
  originalName String?
  prompt       Prompt    @relation(fields: [promptId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())
}

model Favorite {
  id        Int      @id @default(autoincrement())
  userId    Int
  promptId  Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  prompt    Prompt   @relation(fields: [promptId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, promptId])
  @@index([userId])
}

enum MediaType {
  image
  video
}
