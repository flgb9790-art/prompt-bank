# Prompt Bank — скопируйте в .env в корне репозитория.
# В dev backend подхватывает этот файл из backend/ (см. backend/src/config.ts).

# --- PostgreSQL (обязательно) ---
DATABASE_URL=postgresql://user:password@host:5432/prompt_bank
DIRECT_URL=postgresql://user:password@host:5432/prompt_bank

# --- Telegram-бот (обязательно для бота) ---
BOT_TOKEN=

# --- Публичные URL ---
# Mini App / веб (Vite), ссылка в меню бота
WEBAPP_URL=http://localhost:5173
# API (Express), для абсолютных ссылок на медиа с сервера
BACKEND_URL=http://localhost:3001

# Telegram ID админов через запятую (создание/редактирование промптов)
ADMIN_TELEGRAM_IDS=123456789

# --- Медиа и CDN ---
# Публичный origin для /uploads (Cloudflare, Railway static, Supabase CDN и т.д.)
# Дублируйте то же значение в miniapp как VITE_MEDIA_CDN_URL
MEDIA_PUBLIC_URL=

# --- Supabase Storage (опционально, вместо локальной папки uploads) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=uploads

# --- Прочее ---
PORT=3001
UPLOADS_DIR=
SEED_DEMO_DATA=false
NODE_ENV=development
