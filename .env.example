# Prompt Bank — скопируйте в .env в корне репозитория.

# В dev backend подхватывает этот файл из backend/ (см. backend/src/config.ts).



# --- PostgreSQL (обязательно) ---

DATABASE_URL=postgresql://user:password@host:5432/prompt_bank

DIRECT_URL=postgresql://user:password@host:5432/prompt_bank



# --- Telegram-бот (обязательно для бота) ---

BOT_TOKEN=



# --- Telegram-канал (публикация промптов) ---

# Токен бота из @BotFather (можно использовать BOT_TOKEN, если это тот же бот)

TELEGRAM_BOT_TOKEN=

# Username бота без @ — deep link в Mini App для ссылок в Telegram-постах

TELEGRAM_BOT_USERNAME=prmtb_bot

# Username канала (@promptbank_channel) или id (-1001234567890)

TELEGRAM_CHANNEL_ID=

# Публичная ссылка на Telegram-канал (для Pinterest-пинов)

TELEGRAM_CHANNEL_URL=



# --- Pinterest (публикация промптов) ---

PINTEREST_ACCESS_TOKEN=

PINTEREST_BOARD_ID=

PINTEREST_API_BASE_URL=https://api.pinterest.com/v5



# --- Публичные URL ---

# Mini App / веб (HTML). Меню бота и WebApp-кнопки. НЕ URL API.

# Railway mini app: https://diplomatic-communication-production-6b54.up.railway.app

WEBAPP_URL=http://localhost:5173

# Публичный URL сайта для ссылок в Telegram-постах (обычно = WEBAPP_URL)

PUBLIC_SITE_URL=http://localhost:5173

# API (Express). Railway backend: https://prompt-bank-production.up.railway.app

BACKEND_URL=http://localhost:3001

# Публичный URL backend для медиа /uploads в постах канала (обязательно API, не mini app)

PUBLIC_BACKEND_URL=http://localhost:3001



# Telegram ID админов через запятую (создание/редактирование промптов)

ADMIN_TELEGRAM_IDS=123456789



# --- Медиа (Railway Volume или локальная папка) ---

# На Railway: volume mount /data/uploads + UPLOADS_DIR=/data/uploads

UPLOADS_DIR=

# Публичный origin для /uploads (по умолчанию PUBLIC_BACKEND_URL или BACKEND_URL)

MEDIA_PUBLIC_URL=



# --- Supabase Storage (опционально; если не задано — локальный volume /uploads) ---

SUPABASE_URL=

SUPABASE_SERVICE_ROLE_KEY=

SUPABASE_STORAGE_BUCKET=uploads



# Однократная миграция URL с Supabase на Railway (true → после деплоя убрать)

MIGRATE_SUPABASE_MEDIA=



# --- Прочее ---

PORT=3001

SEED_DEMO_DATA=false

NODE_ENV=development

