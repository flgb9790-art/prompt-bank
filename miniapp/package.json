{
  "name": "prompt-bank-miniapp",
  "version": "1.0.21",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/write-runtime-config.mjs dist && node --input-type=module -e \"import { copyFileSync } from 'node:fs'; copyFileSync('serve.json','dist/serve.json')\"",
    "preview": "vite preview",
    "start": "node scripts/write-runtime-config.mjs dist && serve dist -s"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.13.25",
    "@tiptap/extension-link": "^3.23.6",
    "@tiptap/extension-placeholder": "^3.23.6",
    "@tiptap/pm": "^3.23.6",
    "@tiptap/react": "^3.23.6",
    "@tiptap/starter-kit": "^3.23.6",
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "serve": "^14.2.4"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.6.3",
    "vite": "^6.0.5",
    "vite-plugin-pwa": "^1.3.0"
  }
}
