# Скопируйте в miniapp/.env.local или miniapp/.env

# URL backend API (без завершающего слэша). На Railway miniapp: BACKEND_URL при старте (см. docs/DOMAIN.md).
VITE_BACKEND_URL=http://localhost:3001
# VITE_BACKEND_URL=https://api.prompt-bank.one
# BACKEND_URL=https://api.prompt-bank.one

# CDN / публичный origin для картинок и видео (/uploads)
# Обычно совпадает с MEDIA_PUBLIC_URL на backend
VITE_MEDIA_CDN_URL=

# Веб-версия: вход через Telegram Login Widget
VITE_TELEGRAM_AUTH_URL=
# Username бота без @ — для deep link в Mini App из Telegram-постов
VITE_TELEGRAM_BOT_USERNAME=prmtb_bot
# Публичная ссылка на Telegram-канал (для preview Pinterest-публикации)
VITE_TELEGRAM_CHANNEL_URL=https://t.me/your_channel
